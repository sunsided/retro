// sky.wgsl

// Define a uniform holding time and the view-projection matrix.
struct FrameGlobalUniform {
    time: f32,
};

@group(0) @binding(0)
var<uniform> sky: FrameGlobalUniform;

// Vertex output structure (providing position and uv).
struct VertexOutput {
    @builtin(position) position: vec4<f32>,
    @location(0) uv: vec2<f32>,
};

// Full-screen triangle, generated by vertex_index.
@vertex
fn vs_main(@builtin(vertex_index) index: u32) -> VertexOutput {
    // Create three positions that cover the screen.
    var positions = array<vec2<f32>, 3>(
        vec2(-1.0, -1.0),
        vec2( 3.0, -1.0),
        vec2(-1.0,  3.0)
    );
    // Corresponding UVs – these can be used in the fragment shader to, for example, mix sky gradients.
    var uvs = array<vec2<f32>, 3>(
        vec2(0.0, 0.0),
        vec2(2.0, 0.0),
        vec2(0.0, 2.0)
    );
    var out: VertexOutput;
    out.position = vec4<f32>(positions[index], 0.0, 1.0);
    out.uv = uvs[index];
    return out;
}

// Fragment shader computes a simple sky gradient based on time.
@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    // Define two base colors for night and day.
    let night_color = vec3<f32>(0.03, 0.03, 0.2);  // A deep, rich midnight blue
    let day_color   = vec3<f32>(0.4, 0.75, 1.0);     // A vibrant, clear sky blue

    // Compute a weight that oscillates between 0 (night) and 1 (day).
    // When sky.time is 0 or 24, weight becomes 0 (night).
    // When sky.time is 12, weight becomes 1 (day).
    let cycle = 0.5 * (1.0 + cos((sky.time - 12.0) * 2.0 * 3.14159265 / 24.0));

    // Compute effective horizon threshold based on time.
    const low_level: f32 = 0.01;
    const high_level: f32 = 0.3;
    var effective_threshold: f32;
    if (sky.time < 6.0) {
        // Early morning: transition from 0.3 (at midnight) to 0.1 at 6AM.
        effective_threshold = mix(high_level, low_level, smoothstep(0.0, 6.0, sky.time));
    } else if (sky.time > 18.0) {
        // Evening: transition from 0.1 at 6PM to 0.3 at midnight.
        effective_threshold = mix(low_level, high_level, smoothstep(18.0, 24.0, sky.time));
    } else {
        // During most of the day, remain low.
        effective_threshold = low_level;
    }

    // Compute a horizon factor based on the vertical coordinate.
    let horizon = smoothstep(effective_threshold, 1.0, in.uv.y);

    // Interpolate between night and day colors using the cycle.
    // Then modulate by the horizon to simulate a fade toward the horizon.
    let color = mix(night_color, day_color, cycle) * horizon;

    return vec4<f32>(color, 1.0);
}
